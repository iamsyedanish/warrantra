# ---- Server ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=
TRUST_PROXY=false

# ---- Database migrations (npm run db:migrate) ----
# Supabase Dashboard -> Connect -> "Direct connection" or "Session pooler" (port 5432, NOT 6543).
# Local stack (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Optional: path to the Supabase CA certificate (Dashboard -> Database -> SSL) to verify TLS.
DATABASE_SSL_CA=

# ---- Supabase (never ship the service role key in the mobile app) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REDIRECT_URL=warrantra://auth-callback
PASSWORD_RESET_REDIRECT_URL=warrantra://reset-password
REAUTH_MAX_AGE_SECONDS=600
ADMIN_REQUIRE_MFA=true

# 32+ random characters; used to hash tokens/emails for lookups. Rotate carefully.
HASH_PEPPER=

# ---- AI (server-side only) ----
# openai (default) | anthropic | disabled
AI_PROVIDER=openai
OPENAI_API_KEY=
# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=gpt-5.4-mini
# minimal | low | medium | high (reasoning effort)
AI_EFFORT=low
AI_MAX_OUTPUT_TOKENS=6000
AI_CLAIM_DRAFT_MAX_TOKENS=2000
AI_TIMEOUT_MS=60000
# USD per million tokens, used for cost accounting and budget caps.
# Defaults are gpt-5.4-mini list prices; update them if you change AI_MODEL.
AI_PRICE_INPUT_PER_MTOK=0.75
AI_PRICE_CACHED_INPUT_PER_MTOK=0.075
AI_PRICE_OUTPUT_PER_MTOK=4.5

# ---- Billing (RevenueCat) ----
# Value configured as the webhook Authorization header in RevenueCat.
REVENUECAT_WEBHOOK_AUTH=
# Secret (v1) API key used to reconcile authoritative subscriber state.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT=pro
REVENUECAT_BUSINESS_ENTITLEMENT=business_pilot

# ---- Push (FCM HTTP v1; APNs via FCM) ----
PUSH_PROVIDER=log
FCM_PROJECT_ID=
# Full service-account JSON on one line.
FCM_SERVICE_ACCOUNT_JSON=

# ---- Email ----
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM=Warrantra <no-reply@warrantra.app>
SUPPORT_EMAIL=support@warrantra.app

# ---- Inbound email forwarding (Postmark inbound webhook with basic auth) ----
INBOUND_DOMAIN=in.warrantra.app
INBOUND_WEBHOOK_USER=postmark
INBOUND_WEBHOOK_PASSWORD=
INBOUND_REQUIRE_SENDER_AUTH=true

# ---- Storage backups (S3-compatible bucket, separate from Supabase) ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ---- Worker ----
WORKER_NAME=worker-1
WORKER_POLL_MS=5000
CRON_SECRET=

EXPORT_LINK_TTL_SECONDS=3600
EXPORT_RETENTION_DAYS=7
